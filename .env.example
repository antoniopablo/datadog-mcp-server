# Copy to .env and fill in. Read-only keys are sufficient.
DD_API_KEY=your-datadog-api-key
DD_APP_KEY=your-datadog-application-key
# One of: datadoghq.com, datadoghq.eu, us3.datadoghq.com, us5.datadoghq.com, ap1.datadoghq.com
DD_SITE=datadoghq.eu
# Optional: your negotiated price per 100 custom metric series / month (list price used if unset)
DD_PRICE_PER_100_SERIES=0.05
